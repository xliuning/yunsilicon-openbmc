+namespace cpld_i2c
+{
+constexpr int BUS_NUM = 7;
+constexpr uint8_t SLAVE_ADDR = 0x0d; // 7-bit I2C address
+
+// ---------- Register definitions ----------
+constexpr uint8_t REG_POWER_STATUS = 0x17; // Power state: 0x00=OFF, 0x03=ON
+constexpr uint8_t REG_HARD_RESET   = 0x14; // Hard reset trigger
+constexpr uint8_t REG_CTRL_1       = 0x41; // Power control register 1
+constexpr uint8_t REG_CTRL_2       = 0x43; // Power control register 2
+
+// ---------- Timing ----------
+constexpr auto WRITE_DELAY      = std::chrono::milliseconds(100);
+constexpr auto POWER_OFF_WAIT   = std::chrono::seconds(6);
+constexpr auto POWER_CYCLE_WAIT = std::chrono::seconds(4); // Since Power off have 6 seconds delay, only 4 seconds extra delay need
+
+// ---------- Mutex for serializing CPLD access ----------
+static std::mutex cpldMutex;
+
+// ===================== Low-level I2C read/write =====================
+
+static int readReg(uint8_t reg, uint8_t* val)
+{
+    char path[32];
+    snprintf(path, sizeof(path), "/dev/i2c-%d", BUS_NUM);
+    int fd = open(path, O_RDWR);
+    if (fd < 0)
+    {
+        lg2::error("CPLD I2C open {PATH} failed: {ERR}",
+                   "PATH", path, "ERR", strerror(errno));
+        return -errno;
+    }
+    if (ioctl(fd, I2C_SLAVE, SLAVE_ADDR) < 0)
+    {
+        lg2::error("CPLD I2C set addr 0x{ADDR} failed: {ERR}",
+                   "ADDR", lg2::hex, SLAVE_ADDR, "ERR", strerror(errno));
+        close(fd);
+        return -errno;
+    }
+    if (write(fd, &reg, 1) != 1)
+    {
+        lg2::error("CPLD I2C write reg addr 0x{REG} failed: {ERR}",
+                   "REG", lg2::hex, reg, "ERR", strerror(errno));
+        close(fd);
+        return -errno;
+    }
+    if (read(fd, val, 1) != 1)
+    {
+        lg2::error("CPLD I2C read reg 0x{REG} failed: {ERR}",
+                   "REG", lg2::hex, reg, "ERR", strerror(errno));
+        close(fd);
+        return -errno;
+    }
+    close(fd);
+    return 0;
+}
+
+static int writeReg(uint8_t reg, uint8_t val)
+{
+    char path[32];
+    snprintf(path, sizeof(path), "/dev/i2c-%d", BUS_NUM);
+    int fd = open(path, O_RDWR);
+    if (fd < 0)
+    {
+        lg2::error("CPLD I2C open {PATH} failed: {ERR}",
+                   "PATH", path, "ERR", strerror(errno));
+        return -errno;
+    }
+    if (ioctl(fd, I2C_SLAVE, SLAVE_ADDR) < 0)
+    {
+        lg2::error("CPLD I2C set addr 0x{ADDR} failed: {ERR}",
+                   "ADDR", lg2::hex, SLAVE_ADDR, "ERR", strerror(errno));
+        close(fd);
+        return -errno;
+    }
+    uint8_t buf[2] = {reg, val};
+    if (write(fd, buf, 2) != 2)
+    {
+        lg2::error("CPLD I2C write reg 0x{REG} val 0x{VAL} failed: {ERR}",
+                   "REG", lg2::hex, reg, "VAL", lg2::hex, val,
+                   "ERR", strerror(errno));
+        close(fd);
+        return -errno;
+    }
+    close(fd);
+    return 0;
+}
+
+
+/**
+ * Power On sequence:
+ *   0x41 <- 0  →  delay 100ms
+ *   0x43 <- 0  →  delay 100ms
+ *   0x43 <- 1
+ */
+static int doPowerOnLocked()
+{
+    int rc;
+    lg2::info("CPLD PowerOn: start");
+
+    rc = writeReg(REG_CTRL_1, 0x00);
+    if (rc < 0)
+    {
+        lg2::error("PowerOn: write 0x41=0 failed");
+        return rc;
+    }
+    std::this_thread::sleep_for(WRITE_DELAY);
+
+    rc = writeReg(REG_CTRL_2, 0x00);
+    if (rc < 0)
+    {
+        lg2::error("PowerOn: write 0x43=0 failed");
+        return rc;
+    }
+    std::this_thread::sleep_for(WRITE_DELAY);
+
+    rc = writeReg(REG_CTRL_2, 0x01);
+    if (rc < 0)
+    {
+        lg2::error("PowerOn: write 0x43=1 failed");
+        return rc;
+    }
+
+    lg2::info("CPLD PowerOn: done");
+    return 0;
+}
+
+/**
+ * Power Off sequence:
+ *   0x41 <- 0  →  delay 100ms
+ *   0x43 <- 0  →  delay 100ms
+ *   0x41 <- 1  →  wait 6s
+ */
+static int doPowerOffLocked()
+{
+    int rc;
+    lg2::info("CPLD PowerOff: start");
+
+    rc = writeReg(REG_CTRL_1, 0x00);
+    if (rc < 0)
+    {
+        lg2::error("PowerOff: write 0x41=0 failed");
+        return rc;
+    }
+    std::this_thread::sleep_for(WRITE_DELAY);
+
+    rc = writeReg(REG_CTRL_2, 0x00);
+    if (rc < 0)
+    {
+        lg2::error("PowerOff: write 0x43=0 failed");
+        return rc;
+    }
+    std::this_thread::sleep_for(WRITE_DELAY);
+
+    rc = writeReg(REG_CTRL_1, 0x01);
+    if (rc < 0)
+    {
+        lg2::error("PowerOff: write 0x41=1 failed");
+        return rc;
+    }
+
+    lg2::info("CPLD PowerOff: waiting {SEC}s for stabilization",
+              "SEC", POWER_OFF_WAIT.count());
+    std::this_thread::sleep_for(POWER_OFF_WAIT);
+
+    lg2::info("CPLD PowerOff: done");
+    return 0;
+}
+
+/**
+ * Hard Reset:
+ *   0x14 <- 1
+ */
+static int doHardResetLocked()
+{
+    lg2::info("CPLD HardReset: writing 0x14=1");
+    int rc = writeReg(REG_HARD_RESET, 0x01);
+    if (rc < 0)
+    {
+        lg2::error("HardReset: write 0x14=1 failed");
+    }
+    else
+    {
+        lg2::info("CPLD HardReset: done");
+    }
+    return rc;
+}
+
+// ===================== Public interfaces (with mutex) =====================
+
+static int doPowerOn()
+{
+    std::lock_guard<std::mutex> lock(cpldMutex);
+    return doPowerOnLocked();
+}
+
+static int doPowerOff()
+{
+    std::lock_guard<std::mutex> lock(cpldMutex);
+    return doPowerOffLocked();
+}
+
+static int doHardReset()
+{
+    std::lock_guard<std::mutex> lock(cpldMutex);
+    return doHardResetLocked();
+}
+
+/**
+ * Power Cycle:
+ *   PowerOff (includes 6s wait) → delay another 4s → PowerOn
+ */
+static int doPowerCycle()
+{
+    std::lock_guard<std::mutex> lock(cpldMutex);
+    lg2::info("CPLD PowerCycle: start");
+
+    int rc = doPowerOffLocked();
+    if (rc < 0)
+    {
+        lg2::error("PowerCycle: power off phase failed");
+        return rc;
+    }
+
+    lg2::info("CPLD PowerCycle: waiting {SEC}s before power on",
+              "SEC", POWER_CYCLE_WAIT.count());
+    std::this_thread::sleep_for(POWER_CYCLE_WAIT);
+
+    rc = doPowerOnLocked();
+    if (rc < 0)
+    {
+        lg2::error("PowerCycle: power on phase failed");
+        return rc;
+    }
+
+    lg2::info("CPLD PowerCycle: done");
+    return 0;
+}
+
