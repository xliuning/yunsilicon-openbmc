[Unit]
Description=Phosphor Hwmon PECI CPU Temperature
After=xyz.openbmc_project.ObjectMapper.service

[Service]
Type=simple
Restart=on-failure
EnvironmentFile=/etc/default/obmc/hwmon/peci-cpu.conf
ExecStart=/usr/bin/phosphor-hwmon-readd -i PECI_CPU -o /devices/platform/ahb/ahb:apb/1e78b000.peci-controller/peci-0/0-30/peci_cpu.cputemp.icxd.48
SyslogIdentifier=phosphor-hwmon-peci-cpu

[Install]
WantedBy=multi-user.target
